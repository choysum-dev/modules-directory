{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://index.choysum.dev/v1/schema/catalog-entry.schema.json",
  "title": "Choysum Catalog Entry",
  "type": "object",
  "required": ["package", "trust", "maintainers"],
  "properties": {
    "$schema": {
      "type": "string"
    },
    "package": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?!https?://).+"
    },
    "trust": {
      "type": "string",
      "enum": ["official", "verified", "community"]
    },
    "maintainers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["github"],
        "properties": {
          "github": {
            "type": "string",
            "minLength": 1,
            "pattern": "^[A-Za-z0-9-]+$"
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
